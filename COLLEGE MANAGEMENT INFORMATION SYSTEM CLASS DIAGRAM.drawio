        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Student {\n  -studentId: int\n  -name: String\n  -course: String\n  -semester: int\n  -email: String\n  +register(): void\n  +login(): void\n  +viewAttendance(): void\n  +viewMarks(): void\n  +viewReportCard(): void\n  +payFees(): void\n  +submitFeedback(): void\n}\n\nclass Faculty {\n  -facultyId: int\n  -name: String\n  -department: String\n  -email: String\n  +login(): void\n  +markAttendance(): void\n  +enterMarks(): void\n  +viewStudents(): void\n  +evaluatePerformance(): void\n}\n\nclass Department {\n  -departmentId: int\n  -departmentName: String\n  +addFaculty(): void\n  +removeFaculty(): void\n  +viewDepartmentDetails(): void\n}\n\nclass Subject {\n  -subjectId: int\n  -subjectName: String\n  -credits: int\n  +addSubject(): void\n  +updateSubject(): void\n  +assignFaculty(): void\n}\n\nclass Attendance {\n  -attendanceId: int\n  -date: Date\n  -status: String\n  +markAttendance(): void\n  +updateAttendance(): void\n  +calculatePercentage(): float\n}\n\nclass Marks {\n  -marksId: int\n  -internalMarks: float\n  -externalMarks: float\n  -totalMarks: float\n  +enterMarks(): void\n  +updateMarks(): void\n  +calculateTotal(): float\n}\n\nclass ReportCard {\n  -reportId: int\n  -totalMarks: float\n  -percentage: float\n  -grade: String\n  +generateReport(): void\n  +calculatePercentage(): float\n  +calculateGrade(): String\n  +viewReport(): void\n}\n\nclass Fees {\n  -feeId: int\n  -amount: float\n  -paymentDate: Date\n  -paymentStatus: String\n  +payFees(): void\n  +verifyPayment(): boolean\n  +generateReceipt(): void\n}\n\nclass Feedback {\n  -feedbackId: int\n  -rating: int\n  -comments: String\n  -feedbackDate: Date\n  +submitFeedback(): void\n  +updateFeedback(): void\n  +viewFeedback(): void\n}\n\nclass Mentor {\n  -mentorId: int\n  -name: String\n  -department: String\n  +assignStudent(): void\n  +viewMentees(): void\n  +provideGuidance(): void\n  +trackPerformance(): void\n}\n\nDepartment \&quot;1\&quot; -- \&quot;*\&quot; Faculty : has\nDepartment \&quot;1\&quot; -- \&quot;*\&quot; Student : enrolls\nFaculty \&quot;*\&quot; -- \&quot;*\&quot; Subject : teaches\nStudent \&quot;1\&quot; -- \&quot;*\&quot; Attendance : has\nSubject \&quot;1\&quot; -- \&quot;*\&quot; Attendance : records\nStudent \&quot;1\&quot; -- \&quot;*\&quot; Marks : receives\nSubject \&quot;1\&quot; -- \&quot;*\&quot; Marks : evaluates\nStudent \&quot;1\&quot; -- \&quot;*\&quot; ReportCard : receives\nReportCard \&quot;1\&quot; *-- \&quot;*\&quot; Marks : contains\nStudent \&quot;1\&quot; -- \&quot;*\&quot; Fees : pays\nStudent \&quot;1\&quot; -- \&quot;*\&quot; Feedback : submits\nFaculty \&quot;1\&quot; -- \&quot;*\&quot; Feedback : receives\nMentor \&quot;1\&quot; -- \&quot;*\&quot; Student : mentors\nFaculty \&quot;1\&quot; -- \&quot;*\&quot; Attendance : records\nFaculty \&quot;1\&quot; -- \&quot;*\&quot; Marks : enters\n\nstyle Student fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Faculty fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Department fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Subject fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Attendance fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Marks fill:#FFFFFF,stroke:#000000,color:#000000\nstyle ReportCard fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Fees fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Feedback fill:#FFFFFF,stroke:#000000,color:#000000\nstyle Mentor fill:#FFFFFF,stroke:#000000,color:#000000&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="141">
